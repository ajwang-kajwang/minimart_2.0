# Minimart 2.0 - Jetson Orin Nano Configuration
# Copy to .env and modify as needed

# =============================================================================
# CAMERA CONFIGURATION
# =============================================================================

# Camera source type: usb, csi, rtsp, tcp
CAMERA_SOURCE=usb

# Camera device/URL
# USB:  /dev/video0
# CSI:  (automatic via nvarguscamerasrc)
# RTSP: rtsp://192.168.1.100:8554/stream
# TCP:  tcp://127.0.0.1:8888
CAMERA_STREAM_URL=/dev/video0

# Resolution and framerate
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Use GStreamer pipeline (required for CSI cameras)
USE_GSTREAMER=false

# =============================================================================
# DETECTION CONFIGURATION
# =============================================================================

# TensorRT engine path (generated by scripts/export_tensorrt.py)
TENSORRT_ENGINE=models/yolov8s.engine

# Fallback YOLO model (used if TensorRT not available)
YOLO_MODEL=yolov8s.pt

# Detection confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.4

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Use test pattern instead of real camera
USE_TEST_PATTERN=false

# Flask debug mode (set to false in production)
FLASK_DEBUG=false
